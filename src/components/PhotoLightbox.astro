<dialog class="lightbox" data-lightbox aria-label="Full-size photograph / 照片大图">
  <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photograph / 关闭大图">Close / <span lang="zh-CN">关闭</span> ×</button>
  <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Previous photograph / 上一张" title="Previous / 上一张">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
  </button>
  <figure><img data-lightbox-image alt="" /><figcaption data-lightbox-caption></figcaption></figure>
  <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Next photograph / 下一张" title="Next / 下一张">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
  </button>
  <span class="lightbox-count" data-lightbox-count role="status" aria-live="polite" aria-atomic="true"></span>
</dialog>
