---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from './Gallery.astro';
import type { Collection, Photo } from '../data/portfolio';
interface Props {
  collection: Collection;
  kind: 'destinations' | 'categories';
  photos: Photo[];
  currentPage: number;
  lastPage: number;
  total: number;
}
const { collection, kind, photos, currentPage, lastPage, total } = Astro.props;
const basePath = `/${kind}/${collection.slug}/`;
const parent = kind === 'destinations' ? '目的地' : '题材';
const parentEnglish = kind === 'destinations' ? 'Destinations' : 'Subjects';
const label = kind === 'destinations' ? '02 / Destination' : '03 / Subject';
---
<BaseLayout title={`${collection.english} | ${collection.name} — Michael Wang`} description={collection.note} active={kind}>
  <div class="page-wrap">
    <div class="breadcrumbs"><a href={`/${kind}/`}>← <span lang="zh-CN">返回{parent}</span> / {parentEnglish}</a><span>/</span><span>{collection.english}</span></div>
    <header class="gallery-heading"><div><span class="eyebrow">{label}</span><h1>{collection.english}</h1><span class="zh-support" lang="zh-CN">{collection.name}</span></div></header>
    <div class="gallery-toolbar"><span>PHOTO ARCHIVE</span>{total > 0 && <span>{total} PHOTOGRAPHS</span>}</div>
    <Gallery {photos} {currentPage} {lastPage} {basePath} />
  </div>
</BaseLayout>
