---
import type { GalleryPhoto } from '../data/portfolio';
import PhotoLightbox from './PhotoLightbox.astro';
interface Props {
  photos: GalleryPhoto[];
  lightboxPhotos?: GalleryPhoto[];
  currentPage: number;
  lastPage: number;
  basePath: string;
  eagerCount?: number;
}
const { photos, lightboxPhotos = photos, currentPage, lastPage, basePath, eagerCount = 3 } = Astro.props;
const photoIndexes = new Map(lightboxPhotos.map((photo, index) => [photo.id, index]));
const lightboxData = lightboxPhotos.map(({ src, alt, title }) => ({ src, alt, title }));
const pageHref = (page: number) => page === 1 ? basePath : `${basePath}page/${page}/`;
---
{photos.length > 0 ? (
  <div data-gallery data-photos={JSON.stringify(lightboxData)}>
    <div class="photo-grid">
      {photos.map((photo, index) => (
        <button class="photo-card" type="button" data-gallery-open data-photo-index={photoIndexes.get(photo.id)} aria-label={`View photograph: ${photo.alt}`}>
          <img src={photo.thumb} srcset={photo.srcSet} sizes={photo.srcSet ? '(max-width: 900px) 50vw, 33vw' : undefined} alt={photo.alt} width={photo.width} height={photo.height} loading={index < eagerCount ? 'eager' : 'lazy'} decoding="async" />
          <span class="photo-caption">{photo.title ?? photo.alt} <span aria-hidden="true">↗</span></span>
        </button>
      ))}
    </div>
    {lastPage > 1 && <nav class="pagination" aria-label="Photo pagination"><a href={currentPage > 1 ? pageHref(currentPage - 1) : undefined} aria-disabled={currentPage === 1 ? 'true' : undefined}>← Previous / <span lang="zh-CN">上一页</span></a><span>{currentPage} / {lastPage}</span><a href={currentPage < lastPage ? pageHref(currentPage + 1) : undefined} aria-disabled={currentPage === lastPage ? 'true' : undefined}>Next / <span lang="zh-CN">下一页</span> →</a></nav>}
    <PhotoLightbox />
    <script>
      import { createLightbox, type LightboxPhoto } from '../scripts/lightbox';
      document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
        const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
        if (!dialog) return;
        const photos: LightboxPhoto[] = JSON.parse(gallery.dataset.photos ?? '[]');
        const lightbox = createLightbox(dialog, photos);
        gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach((button) => {
          button.addEventListener('click', () => lightbox.open(Number(button.dataset.photoIndex)));
        });
      });
    </script>
  </div>
) : <div class="gallery-empty"><span class="empty-mark" aria-hidden="true">✳</span><p>Photographs to come</p></div>}
