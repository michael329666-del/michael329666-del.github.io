---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="关于我 / About — Michael Wang" description="王牧川 / Michael Wang — Penn State University, State College, PA. 设备与联系方式 / Equipment and contact." active="about">
  <section class="about-surface">
    <div class="page-wrap about-page">
      <header class="about-heading">
        <span class="eyebrow" aria-hidden="true">04</span>
        <h1><span lang="zh-CN">关于我</span><span class="heading-divider" aria-hidden="true">/</span><span lang="en">About</span></h1>
      </header>
      <div class="about-grid">
        <figure class="about-portrait">
          <img
            src="/photos/about/michael-wang.webp"
            srcset="/photos/about/michael-wang-400.webp 400w, /photos/about/michael-wang.webp 800w"
            sizes="(max-width: 540px) 202px, 262px"
            width="800"
            height="800"
            alt="王牧川 / Michael Wang"
            decoding="async"
          />
        </figure>
        <div class="language-columns">
          <section class="language-column" lang="zh-CN" aria-labelledby="name-zh">
            <h2 class="identity-name" id="name-zh">王牧川</h2>
            <div class="identity-details">
              <p>宾夕法尼亚州立大学</p>
              <p>State College, PA</p>
            </div>
            <section aria-labelledby="equipment-zh">
              <h3 class="equipment-heading" id="equipment-zh">设备</h3>
              <dl class="equipment-list">
                <div class="equipment-row">
                  <dt>相机：</dt>
                  <dd>松下 LUMIX S1R II<span class="lens-line">镜头：24–60mm / 70–300mm</span></dd>
                </div>
                <div class="equipment-row">
                  <dt>口袋相机：</dt>
                  <dd>大疆 Osmo Pocket 4P</dd>
                </div>
                <div class="equipment-row">
                  <dt>拍立得：</dt>
                  <dd>徕卡 SOFORT 拍立得</dd>
                </div>
              </dl>
            </section>
          </section>
          <section class="language-column" lang="en" aria-labelledby="name-en">
            <h2 class="identity-name" id="name-en">Michael Wang</h2>
            <div class="identity-details">
              <p>Penn State University</p>
              <p>State College, PA</p>
            </div>
            <section aria-labelledby="equipment-en">
              <h3 class="equipment-heading" id="equipment-en">Equipment</h3>
              <dl class="equipment-list">
                <div class="equipment-row">
                  <dt>Camera:</dt>
                  <dd>Panasonic LUMIX S1R II<span class="lens-line">Lenses: 24–60mm / 70–300mm</span></dd>
                </div>
                <div class="equipment-row">
                  <dt>Pocket camera:</dt>
                  <dd>DJI Osmo Pocket 4P</dd>
                </div>
                <div class="equipment-row">
                  <dt>Instant camera:</dt>
                  <dd>Leica SOFORT</dd>
                </div>
              </dl>
            </section>
          </section>
        </div>
        <section class="about-contact" aria-labelledby="contact-heading">
          <h2 id="contact-heading"><span lang="zh-CN">联系</span><span class="heading-divider" aria-hidden="true">/</span><span lang="en">Contact</span></h2>
          <p class="contact-address" lang="en">starboymc329 at gmail dot com</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-surface {
    --about-rule: rgba(25, 23, 21, .14);
    --about-serif: Georgia, "Times New Roman", "Songti SC", "STSong", "SimSun", serif;
    background:
      radial-gradient(ellipse at 0 35%, rgba(216, 207, 195, .32), transparent 55%),
      linear-gradient(180deg, var(--paper) 0%, var(--paper-light) 32%, var(--paper-light) 82%, var(--paper) 100%);
  }
  .about-page {
    max-width: 1440px;
    padding: clamp(2.5rem, 4.5vw, 4.5rem) clamp(1.5rem, 5vw, 5rem) clamp(4rem, 7vw, 7rem);
  }
  .about-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--about-rule);
  }
  .about-heading .eyebrow { order: 1; font-size: .7rem; font-weight: 400; }
  .about-heading h1 {
    display: flex;
    align-items: baseline;
    gap: .9rem;
    margin: 0;
    font-size: .8rem;
    font-weight: 400;
    letter-spacing: .08em;
  }
  .about-heading h1 > [lang="en"] { font-size: .68rem; letter-spacing: .17em; text-transform: uppercase; }
  .heading-divider { color: var(--signal); opacity: .6; }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(240px, .8fr) minmax(0, 2fr);
    column-gap: clamp(2.5rem, 5.5vw, 5rem);
    align-items: start;
  }
  .about-portrait {
    grid-column: 1;
    grid-row: 1;
    width: min(100%, 280px);
    margin: 0;
    padding: 8px;
    border: 1px solid rgba(109, 103, 97, .18);
    background: #fff;
    box-shadow: 0 18px 32px -26px rgba(57, 39, 27, .24);
  }
  .about-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .language-columns {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(6, auto);
    column-gap: clamp(1.5rem, 3.5vw, 3.5rem);
    padding-top: .35rem;
  }
  .language-column { display: grid; grid-template-rows: subgrid; grid-row: span 6; min-width: 0; }
  .language-column > section { display: grid; grid-template-rows: subgrid; grid-row: span 4; }
  .identity-name {
    margin: 0 0 1.15rem;
    font-family: var(--about-serif);
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: 1.2;
  }
  .language-column[lang="zh-CN"] .identity-name { letter-spacing: .06em; }
  .identity-details { margin-bottom: 2.8rem; color: var(--muted); font-size: .82rem; line-height: 1.9; }
  .identity-details p { margin: 0; }
  .identity-details p + p { font-size: .7rem; letter-spacing: .03em; }
  .equipment-heading {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin: 0;
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--about-rule);
    color: var(--signal);
    font-size: .65rem;
    font-weight: 500;
    letter-spacing: .13em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .equipment-heading::before { width: .28rem; height: .28rem; background: currentColor; border-radius: 50%; content: ""; }
  .equipment-list { display: grid; grid-template-rows: subgrid; grid-row: span 3; margin: 0; }
  .equipment-row { padding: 1.1rem 0; }
  .equipment-row + .equipment-row { border-top: 1px solid rgba(25, 23, 21, .07); }
  .equipment-row dt { margin: 0 0 .35rem; color: var(--muted); font-size: .7rem; line-height: 1.6; }
  .equipment-row dd { margin: 0; font-size: clamp(.92rem, 1.25vw, 1.1rem); font-weight: 400; letter-spacing: -.02em; line-height: 1.6; }
  .lens-line { display: block; margin-top: .45rem; color: var(--muted); font-size: .75rem; font-weight: 400; letter-spacing: 0; line-height: 1.8; }
  .about-contact {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    min-width: 0;
    margin-top: clamp(2.75rem, 5vw, 4.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.75rem);
    border-top: 1px solid var(--about-rule);
  }
  .about-contact h2 { display: flex; align-items: baseline; gap: .7rem; margin: 0; color: var(--signal); font-size: .74rem; font-weight: 400; letter-spacing: .06em; }
  .about-contact h2 > [lang="en"] { font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .contact-address {
    margin: 0;
    font-family: var(--about-serif);
    font-size: clamp(1.7rem, 3.2vw, 2.9rem);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .about-grid { grid-template-columns: 230px minmax(0, 1fr); gap: 2.25rem; }
    .identity-name { font-size: 1.95rem; }
    .language-columns { column-gap: 1.5rem; }
  }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; row-gap: 2.75rem; }
    .about-portrait { max-width: 280px; justify-self: center; }
    .language-columns { grid-column: 1; column-gap: clamp(1.5rem, 6vw, 3.5rem); }
    .identity-name { font-size: clamp(2rem, 4.6vw, 2.8rem); }
    .identity-details { margin-bottom: 2rem; }
    .about-contact { grid-template-columns: 1fr; gap: 1.25rem; margin-top: .25rem; }
    .contact-address { font-size: clamp(1.7rem, 4.8vw, 2.7rem); }
  }
  @media (max-width: 540px) {
    .about-heading { margin-bottom: 2.25rem; }
    .about-portrait { max-width: 220px; }
    .language-columns { column-gap: 1.25rem; }
    .identity-name { margin-bottom: .8rem; font-size: 2rem; }
    .identity-details { margin-bottom: 1.75rem; font-size: .74rem; }
    .identity-details p + p { font-size: .64rem; }
    .equipment-row { padding-block: 1rem; }
    .equipment-row dd { font-size: .92rem; }
    .lens-line { font-size: .64rem; }
    .contact-address { max-width: 15em; font-size: clamp(1.65rem, 6.7vw, 2.25rem); }
  }
</style>
