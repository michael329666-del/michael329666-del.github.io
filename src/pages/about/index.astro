---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="关于我 / About — Michael Wang" description="王牧川 / Michael Wang — Penn State University, State College, PA. 设备与联系方式 / Equipment and contact." active="about">
  <section class="about-surface">
    <div class="page-wrap about-page">
      <header class="about-heading">
        <span class="eyebrow" aria-hidden="true">04</span>
        <h1><span lang="zh-CN">关于我</span><span class="heading-divider" aria-hidden="true">/</span><span lang="en">About</span></h1>
      </header>
      <div class="about-grid">
        <figure class="about-portrait" aria-label="肖像照片预留位置 / Portrait placeholder">
          <div class="portrait-placeholder"><span lang="zh-CN">肖像照片</span><span lang="en">Portrait</span></div>
        </figure>
        <div class="language-columns">
          <section class="language-column" lang="zh-CN" aria-labelledby="name-zh">
            <h2 class="identity-name" id="name-zh">王牧川</h2>
            <div class="identity-details">
              <p>宾夕法尼亚州立大学</p>
              <p>State College, PA</p>
            </div>
            <section aria-labelledby="equipment-zh">
              <h3 class="equipment-heading" id="equipment-zh">设备</h3>
              <dl class="equipment-list">
                <div class="equipment-row">
                  <dt>相机：</dt>
                  <dd>松下 LUMIX S1R II<span class="lens-line">镜头：24–60mm / 70–300mm</span></dd>
                </div>
                <div class="equipment-row">
                  <dt>口袋相机：</dt>
                  <dd>大疆 Osmo Pocket 4P</dd>
                </div>
                <div class="equipment-row">
                  <dt>拍立得：</dt>
                  <dd>徕卡 SOFORT</dd>
                </div>
              </dl>
            </section>
          </section>
          <section class="language-column" lang="en" aria-labelledby="name-en">
            <h2 class="identity-name" id="name-en">Michael Wang</h2>
            <div class="identity-details">
              <p>Penn State University</p>
              <p>State College, PA</p>
            </div>
            <section aria-labelledby="equipment-en">
              <h3 class="equipment-heading" id="equipment-en">Equipment</h3>
              <dl class="equipment-list">
                <div class="equipment-row">
                  <dt>Camera:</dt>
                  <dd>Panasonic LUMIX S1R II<span class="lens-line">Lenses: 24–60mm / 70–300mm</span></dd>
                </div>
                <div class="equipment-row">
                  <dt>Pocket camera:</dt>
                  <dd>DJI Osmo Pocket 4P</dd>
                </div>
                <div class="equipment-row">
                  <dt>Instant camera:</dt>
                  <dd>Leica SOFORT</dd>
                </div>
              </dl>
            </section>
          </section>
        </div>
        <section class="about-contact" aria-labelledby="contact-heading">
          <h2 id="contact-heading"><span lang="zh-CN">联系</span><span class="heading-divider" aria-hidden="true">/</span><span lang="en">Contact</span></h2>
          <p class="contact-address" lang="en">starboymc329 at gmail dot com</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-surface {
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-light) 38%, var(--paper-light) 78%, var(--paper) 100%);
  }
  .about-page { padding-block: clamp(2rem, 3.5vw, 3rem) clamp(3rem, 5vw, 5rem); }
  .about-heading { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .about-heading h1 { display: flex; align-items: baseline; gap: .65rem; margin: 0; font-size: 1rem; font-weight: 500; }
  .heading-divider { color: var(--muted); }
  .about-grid { display: grid; grid-template-columns: minmax(240px, .82fr) minmax(0, 2fr); column-gap: clamp(2rem, 4.5vw, 4rem); align-items: start; }
  .about-portrait {
    position: relative;
    grid-column: 1;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    margin: 0;
    border: 1px solid var(--line);
    background: linear-gradient(145deg, var(--paper-light) 0%, var(--paper) 28%, var(--stone) 100%);
  }
  .about-portrait::before { position: absolute; top: -1px; left: -1px; width: 3rem; height: 3px; background: var(--signal); content: ""; }
  .portrait-placeholder { display: grid; gap: .3rem; color: var(--muted); font-size: .8rem; font-weight: 400; text-align: center; }
  .language-columns { grid-column: 2; position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 2.5vw, 2.5rem); }
  .language-columns::before { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: linear-gradient(180deg, transparent, var(--line) 15%, var(--line) 85%, transparent); content: ""; }
  .language-column { min-width: 0; }
  .identity-name { margin: 0 0 .6rem; font-size: clamp(1.75rem, 2.7vw, 2.2rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .identity-details { margin-bottom: 1.8rem; color: var(--muted); font-size: .85rem; line-height: 1.8; }
  .identity-details p { margin: 0; }
  .equipment-heading { margin: 0 0 .8rem; font-size: .94rem; font-weight: 600; }
  .equipment-list { margin: 0; }
  .equipment-row { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr); gap: .9rem; min-height: 3.6rem; padding: .85rem 0; border-top: 1px solid var(--line); }
  .equipment-row:first-child { min-height: 5rem; }
  .equipment-row:last-child { border-bottom: 1px solid var(--line); }
  .equipment-row dt { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.8; }
  .equipment-row dd { min-width: 0; margin: 0; font-size: 1.05rem; font-weight: 500; line-height: 1.65; }
  .lens-line { display: block; margin-top: .35rem; color: var(--muted); font-size: .875rem; font-weight: 400; }
  .about-contact { grid-column: 2; min-width: 0; margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .about-contact h2 { display: flex; align-items: baseline; gap: .6rem; margin: 0 0 .6rem; color: var(--signal); font-size: .85rem; font-weight: 500; }
  .contact-address { margin: 0; font-size: clamp(1.25rem, 2.6vw, 2.1rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.5; overflow-wrap: anywhere; }
  @media (max-width: 1060px) {
    .equipment-row { grid-template-columns: 1fr; gap: .2rem; }
  }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-portrait { grid-column: 1; grid-row: auto; max-width: 300px; margin-bottom: 2rem; }
    .language-columns, .about-contact { grid-column: 1; }
  }
  @media (max-width: 640px) {
    .language-columns { grid-template-columns: 1fr; gap: 2rem; }
    .language-columns::before { display: none; }
    .identity-name { font-size: 1.75rem; }
    .equipment-row { grid-template-columns: 5rem minmax(0, 1fr); gap: .7rem; }
  }
</style>
