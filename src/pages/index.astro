---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepagePhotos } from '../data/homepage';
import Gallery from '../components/Gallery.astro';
import FeaturedSlideshow from '../components/FeaturedSlideshow.astro';
---
<BaseLayout title="Selected works | 精选作品 — Michael Wang" description="Places. People. Light. Selected photographs by Michael Wang." active="selected">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-intro">
      <span class="eyebrow signal-label"><i aria-hidden="true"></i> STARBOY / SIGNAL 001</span>
      <h1 id="home-title">Selected<br /><em>works.</em></h1>
      <span class="zh-support" lang="zh-CN">精选作品</span>
      <p class="hero-micro">Places. People. Light.</p>
      <a class="text-link" href="#selected">Explore <span aria-hidden="true">↓</span></a>
    </div>
    <FeaturedSlideshow photos={homepagePhotos} />
  </section>
  <section id="selected" class="page-wrap selected-section">
    <div class="section-lead">
      <span class="eyebrow">01 / SELECTED — {String(homepagePhotos.length).padStart(2, '0')} PHOTOGRAPHS</span>
      <div><h2>Selected works.</h2><span class="zh-support" lang="zh-CN">精选作品</span></div>
    </div>
    <div class="home-gallery"><Gallery photos={homepagePhotos} currentPage={1} lastPage={1} basePath="/" eagerCount={0} /></div>
  </section>
  <section class="home-next">
    <div><span class="eyebrow">CONTINUE EXPLORING</span><h2>Keep exploring.</h2></div>
    <div class="next-links">
      <a href="/destinations/"><span class="next-label">Destinations <small lang="zh-CN">目的地</small></span><span aria-hidden="true">↗</span></a>
      <a href="/categories/"><span class="next-label">Subjects <small lang="zh-CN">题材</small></span><span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding-block: clamp(3rem, 5vw, 5rem); }
  .home-gallery :global(.photo-grid) { display: block; columns: 3; column-gap: clamp(1rem, 2.5vw, 2rem); }
  .home-gallery :global(.photo-card) { display: inline-block; margin-bottom: clamp(2rem, 3.5vw, 3.5rem); break-inside: avoid; }
  .home-gallery :global(.photo-card img) { height: auto; aspect-ratio: auto; }
  @media (max-width: 900px) {
    .home-hero { gap: 2.5rem; }
    .home-gallery :global(.photo-grid) { columns: 2; }
  }
  @media (max-width: 620px) {
    .home-hero { padding-top: 2.25rem; gap: 2rem; }
    .home-intro h1 { margin-block: 1.1rem; }
    .home-intro .zh-support { margin-top: 1rem; }
    .hero-micro { margin-block: 1.5rem 1rem; }
    .home-gallery :global(.photo-grid) { column-gap: .85rem; }
    .home-gallery :global(.photo-caption) { font-size: .65rem; }
  }
</style>
