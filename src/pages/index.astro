---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/portfolio';
import Gallery from '../components/Gallery.astro';
const selected = photos.filter((photo) => photo.featured);
---
<BaseLayout title="Selected works | 精选作品 — Michael Wang" description="Places. People. Light. Selected photographs by Michael Wang." active="selected">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-intro"><span class="eyebrow signal-label"><i aria-hidden="true"></i> STARBOY / SIGNAL 001</span><h1 id="home-title">Selected<br /><em>works.</em></h1><span class="zh-support" lang="zh-CN">精选作品</span><p class="hero-micro">Places. People. Light.</p><a class="text-link" href="#selected">Explore <span aria-hidden="true">↓</span></a></div>
    <div class="feature-stage">
      {selected.length > 0 ? <div class="feature-slides">{selected.map((photo, index) => <img src={photo.src} alt={photo.alt} class:list={['feature-slide', index === 0 && 'is-active']} data-feature-slide />)}</div> : <div class="feature-placeholder"><span class="feature-cross" aria-hidden="true">✳</span><span>SELECTED PHOTOGRAPHS<br />COMING SOON</span></div>}
      <div class="feature-bottom"><span>001 — A PERSONAL ARCHIVE</span>{selected.length > 1 && <div class="feature-controls"><button type="button" data-feature-prev aria-label="Previous photograph">←</button><span data-feature-count>01 / {String(selected.length).padStart(2, '0')}</span><button type="button" data-feature-next aria-label="Next photograph">→</button><button type="button" data-feature-toggle aria-label="Pause slideshow" aria-pressed="false">Pause</button></div>}</div>
    </div>
  </section>
  <section id="selected" class="page-wrap selected-section"><div class="section-lead"><span class="eyebrow">01 / SELECTED</span><div><h2>Selected works.</h2><span class="zh-support" lang="zh-CN">精选作品</span></div></div><Gallery photos={selected} currentPage={1} lastPage={1} basePath="/" /></section>
  <section class="home-next"><div><span class="eyebrow">CONTINUE EXPLORING</span><h2>Keep exploring.</h2></div><div class="next-links"><a href="/destinations/"><span class="next-label">Destinations <small lang="zh-CN">目的地</small></span><span aria-hidden="true">↗</span></a><a href="/categories/"><span class="next-label">Subjects <small lang="zh-CN">题材</small></span><span aria-hidden="true">↗</span></a></div></section>
  <script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-feature-slide]')];
    const count = document.querySelector<HTMLElement>('[data-feature-count]');
    let current = 0;
    function show(index: number) {
      if (!slides.length) return;
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
      if (count) count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    }
    document.querySelector('[data-feature-prev]')?.addEventListener('click', () => show(current - 1));
    document.querySelector('[data-feature-next]')?.addEventListener('click', () => show(current + 1));
    const toggle = document.querySelector<HTMLButtonElement>('[data-feature-toggle]');
    let timer: ReturnType<typeof setInterval> | undefined;
    const start = () => { if (slides.length > 1 && !timer) timer = setInterval(() => show(current + 1), 6000); };
    const stop = () => { if (timer) clearInterval(timer); timer = undefined; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (toggle) { toggle.textContent = 'Play'; toggle.setAttribute('aria-label', 'Play slideshow'); toggle.setAttribute('aria-pressed', 'true'); }
    } else start();
    toggle?.addEventListener('click', () => {
      if (timer) {
        stop();
        toggle.textContent = 'Play';
        toggle.setAttribute('aria-label', 'Play slideshow');
        toggle.setAttribute('aria-pressed', 'true');
      } else {
        start();
        toggle.textContent = 'Pause';
        toggle.setAttribute('aria-label', 'Pause slideshow');
        toggle.setAttribute('aria-pressed', 'false');
      }
    });
  </script>
</BaseLayout>
