---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: 'selected' | 'destinations' | 'categories' | 'about';
}

const { title, description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1ede5" />
    <meta name="description" content={description} />
    <meta name="author" content="Michael Wang" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content / <span lang="zh-CN">跳至正文</span></a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Michael Wang — Selected works">
        <span class="brand-name">Michael Wang</span>
        <span class="brand-signal"><i aria-hidden="true"></i>Starboy / Signal 001</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation / 主导航">
        <a href="/" aria-current={active === 'selected' ? 'page' : undefined}><span class="nav-zh" lang="zh-CN">精选</span><span class="nav-divider" aria-hidden="true">/</span><span class="nav-en">Selected</span></a>
        <a href="/destinations/" aria-current={active === 'destinations' ? 'page' : undefined}><span class="nav-zh" lang="zh-CN">目的地</span><span class="nav-divider" aria-hidden="true">/</span><span class="nav-en">Destinations</span></a>
        <a href="/categories/" aria-current={active === 'categories' ? 'page' : undefined}><span class="nav-zh" lang="zh-CN">题材</span><span class="nav-divider" aria-hidden="true">/</span><span class="nav-en">Subjects</span></a>
        <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}><span class="nav-zh" lang="zh-CN">关于我</span><span class="nav-divider" aria-hidden="true">/</span><span class="nav-en">About</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Michael Wang</span><span>Starboy / Signal 001</span><a href="#main"><span lang="zh-CN">回到顶部</span> / Back to top ↑</a></footer>
  </body>
</html>
